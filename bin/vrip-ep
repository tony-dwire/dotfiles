#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: vrip-ep 'Show Name' <season> [first_episode] [-y] [-s MODE] [-d MODE]"
    echo ""
    echo "Rips TV episodes from the DVD or Blu-ray in /dev/sr0 into a Jellyfin layout:"
    echo "  Show Name/Season 01/Show Name S01E01.mp4"
    echo ""
    echo "first_episode lets you continue a multi-disc set:"
    echo "  vrip-ep 'Bluey' 1        # disk 1: episodes 1-26"
    echo "  vrip-ep 'Bluey' 1 27     # disk 2: episodes 27-52"
    echo ""
    echo "Options:"
    echo "  -y, --yes          Don't ask for confirmation before encoding"
    echo "  -s, --subs [MODE]  Include subtitles (DVD VobSub / Blu-ray PGS tracks). MODE is one of:"
    echo "                       burn   burn the first subtitle track into the video"
    echo "                              (default when MODE is omitted)"
    echo "                       all    keep every subtitle track in the output
                              (this forces MKV output: neither Blu-ray PGS
                              nor DVD VobSub fits in mp4)"
    echo "                       <lang> a 2-letter language code (e.g. en, de);"
    echo "                              restricts to that language, and burns it"
    echo "                              (add 'all' after the code to keep all"
    echo "                              matching tracks instead, e.g. -s en all)"
    echo "  -d, --deint MODE   Filter for interlacing/pulldown. MODE is one of:"
    echo "                       decomb (default) comb-detect + decomb; right for"
    echo "                              genuinely interlaced sources (PAL discs)"
    echo "                       detel  detelecine + decomb; right for NTSC film/"
    echo "                              anime (23.976fps with 3:2 pulldown)"
    echo "                       yadif  plain deinterlace"
    echo "                       off    no filtering"
    echo ""
    echo "Environment overrides:"
    echo "  VRIP_DEV=/dev/sr0        device to read from"
    echo "  VRIP_EP_MIN_SECS=120     ignore titles shorter than this (warnings, logos)"
    echo "  VRIP_EP_TOL_SECS=90      titles within this many seconds of each other"
    echo "                           are considered the same episode length"
    exit 1
}

[ $# -ge 2 ] || usage

show_name="$1"; shift
season="$1"; shift
first_ep=1
auto_yes=0
subs_mode=""
subs_lang=""
deint=decomb
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) auto_yes=1 ;;
        -d|--deint)
            deint="${2:-}"
            case "$deint" in
                decomb|detel|yadif|off) ;;
                detelecine) deint=detel ;;
                *) echo "Error: --deint must be decomb, detel, yadif, or off." >&2; exit 1 ;;
            esac
            shift
            ;;
        -s|--subs)
            arg="${2:-}"
            case "$arg" in
                ""|-*) subs_mode=burn ;;
                burn) subs_mode=burn ;;
                all) subs_mode=all ;;
                *) subs_lang="$arg"
                   if [ "${3:-}" = "all" ]; then
                       subs_mode=all; shift
                   else
                       subs_mode=burn
                   fi ;;
            esac
            [[ "$arg" == -* || -z "$arg" ]] || shift
            ;;
        -h|--help) usage ;;
        *) first_ep="$1" ;;
    esac
    shift
done

subargs=()
if [ -n "$subs_lang" ]; then
    subargs+=(--subtitle-lang-list "$subs_lang")
fi
case "$subs_mode" in
    burn) subargs+=(--subtitle-burned) ;;
    all)  subargs+=(--all-subtitles) ;;
esac

case "$deint" in
    decomb) deintargs=(--comb-detect --decomb) ;;
    detel)  deintargs=(--detelecine --comb-detect --decomb) ;;
    yadif)  deintargs=(--deinterlace yadif) ;;
    off)    deintargs=() ;;
esac

dev="${VRIP_DEV:-/dev/sr0}"
min_secs="${VRIP_EP_MIN_SECS:-120}"
tol_secs="${VRIP_EP_TOL_SECS:-90}"

# Audible notification: freedesktop event sound, terminal bell as fallback.
ding() {
    canberra-gtk-play -i "${1:-complete}" 2>/dev/null \
        || printf '\a'
}

cluster() {
    awk -v min="$min_secs" -v tol="$tol_secs" '
    $1 == "Title:" {
        cur = $2 + 0
        split($4, t, ":")
        tsecs[cur] = t[1]*3600 + t[2]*60 + t[3]
        nc[cur] = 0
        if (cur > maxt) maxt = cur
    }
    $1 == "Chapter:" && cur {
        split($4, t, ":")
        secs = t[1]*3600 + t[2]*60 + t[3]
        if (secs < min) next
        nc[cur]++
        cdur[cur, nc[cur]] = secs
        cnum[cur, nc[cur]] = $2 + 0
    }
    END {
        # pool of candidate episode durations
        n = 0
        for (ti = 1; ti <= maxt; ti++)
            if (ti in tsecs && tsecs[ti] >= min) pool[++n] = tsecs[ti]
        for (ti = 1; ti <= maxt; ti++)
            for (ci = 1; ci <= nc[ti]; ci++) pool[++n] = cdur[ti, ci]
        # sort (n is small; insertion sort is fine)
        for (i = 2; i <= n; i++) {
            d = pool[i]; j = i - 1
            while (j >= 1 && pool[j] > d) { pool[j+1] = pool[j]; j-- }
            pool[j+1] = d
        }
        # densest window of durations = the episode length
        best = 0
        for (i = 1; i <= n; i++) {
            cnt = 0
            for (j = i; j <= n && pool[j] - pool[i] <= tol; j++) cnt++
            if (cnt > best) { best = cnt; med = pool[int((i + j - 1) / 2)] }
        }
        if (best == 0) exit 1
        # A title within +/-40% of the episode length is one standalone
        # episode; a longer (play-all) title contributes each of its
        # episode-length chapters instead.
        for (ti = 1; ti <= maxt; ti++) {
            if (!(ti in tsecs) || tsecs[ti] < min) continue
            if (tsecs[ti] >= 0.6 * med && tsecs[ti] <= 1.4 * med) {
                print ti, 0, tsecs[ti]
            } else {
                for (ci = 1; ci <= nc[ti]; ci++)
                    if (cdur[ti, ci] >= 0.6 * med && cdur[ti, ci] <= 1.4 * med)
                        print ti, cnum[ti, ci], cdur[ti, ci]
            }
        }
    }
'
}

echo "Scanning disc layout..."
# Episode discs come in two layouts:
#   1. junk titles (FBI warnings, logos), one giant "play all" title, and one
#      title per episode (e.g. Bluey)
#   2. one or more giant "play all" titles with each episode as a chapter
#      (e.g. Sword Art Online), plus maybe a few standalone episode titles
# Either way the episodes run about the same length, so: pool every title
# length and every long-enough chapter length, find the densest cluster of
# similar durations = the episode length, then emit one rip unit per episode:
#   "<title> 0 <secs>"           standalone episode title
#   "<title> <chapter> <secs>"   a chapter of a play-all title
# The clustering logic is media-agnostic; only the scan source differs.
# DVDs: lsdvd. Blu-rays: lsdvd can't read those, so use HandBrake's JSON
# title scan and re-emit the same "Title:/Chapter:" lines lsdvd produces.
scan_text=$(lsdvd -x "$dev" 2>/dev/null || true)
disc=dvd
if [ -z "$scan_text" ]; then
    echo "No DVD structure found; probing for a Blu-ray..."
    bd_json=$(HandBrakeCLI -i "$dev" -t 0 --scan --json </dev/null 2>/dev/null || true)
    scan_text=$(BD_JSON="$bd_json" python3 <<'PY'
import os, sys, json
raw = os.environ.get("BD_JSON") or ""
i = raw.find("{")
if i < 0:
    sys.exit(1)
try:
    doc = json.loads(raw[i:])
except Exception:
    sys.exit(1)
titles = (doc.get("JSONTitleSet") or {}).get("TitleList") or []
if not titles:
    sys.exit(1)
for t in titles:
    print("Title: %s, Duration: %s," % (t.get("Index"), t.get("Duration")))
    for ch in t.get("ChapterList") or []:
        print("Chapter: %s, Duration: %s," % (ch.get("ChapterNumber"), ch.get("Duration")))
PY
) || true
    if [ -n "$scan_text" ]; then disc=bd; fi
fi

if [ -z "$scan_text" ]; then
    ding bell
    echo "Error: Could not read the disc as a DVD or Blu-ray. Is the right disc inserted?"
    echo "If this is an encrypted Blu-ray, you need a KEYDB.cfg for libaacs (or MakeMKV)."
    exit 1
fi

detected=$(cluster <<< "$scan_text") || true

if [ -z "${detected:-}" ]; then
    ding bell
    echo "Error: No episode-like titles found. Is the right disc inserted?"
    exit 1
fi

# PGS subtitles (Blu-ray) cannot be muxed into mp4; fall back to mkv.
# HandBrake rejects VobSub (DVD) and PGS (Blu-ray) in mp4, so keeping the
# tracks as-is needs Matroska whichever media the episodes came from.
container=mp4
if [ "$subs_mode" = all ]; then
    container=mkv
fi

season_padded=$(printf '%02d' "$season")
season_dir="${show_name}/Season ${season_padded}"
total=$(wc -l <<< "$detected")

echo "Detected $total episodes:"
case "$subs_mode" in
    burn) echo "Subtitles: burning${subs_lang:+ $subs_lang} first subtitle track into video" ;;
    all)  if [ "$disc" = bd ]; then
              echo "Subtitles: keeping all tracks${subs_lang:+ ($subs_lang)} as PGS in .mkv"
          else
              echo "Subtitles: keeping all tracks${subs_lang:+ ($subs_lang)} as VobSub in .mkv"
          fi ;;
esac
ep=$first_ep
while read -r title chap secs; do
    outfile=$(printf '%s S%02dE%02d.%s' "$show_name" "$season" "$ep" "$container")
    if [ "$chap" = "0" ]; then src=$(printf 'Title %d' "$title")
    else src=$(printf 'Title %d ch %d' "$title" "$chap"); fi
    printf '  %-16s (%4d min) -> %s/%s\n' "$src" "$(( ${secs%.*} / 60 ))" "$season_dir" "$outfile"
    ep=$((ep + 1))
done <<< "$detected"

if [ "$auto_yes" -eq 0 ]; then
    read -rp "Rip these $total episodes? [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]] || exit 0
fi

mkdir -p "$season_dir"

# Read straight from the disc: libdvdnav follows the real playback path,
# which sidesteps ARccOS-style protection (bogus sectors / fake angles)
# that breaks full-disc mirroring with dvdbackup.
ep=$first_ep
fails=0
while read -r title chap secs; do
    outfile=$(printf '%s S%02dE%02d.%s' "$show_name" "$season" "$ep" "$container")
    outpath="${season_dir}/${outfile}"
    if [ -s "$outpath" ]; then
        echo "[S${season_padded}E$(printf '%02d' "$ep")] exists, skipping."
        ep=$((ep + 1)); continue
    fi
    if [ "$chap" = "0" ]; then
        chapargs=()
        echo "[S${season_padded}E$(printf '%02d' "$ep")] Encoding Title $title..."
    else
        chapargs=(--chapters "$chap-$chap")
        echo "[S${season_padded}E$(printf '%02d' "$ep")] Encoding Title $title, Chapter $chap..."
    fi
    if ! HandBrakeCLI -i "$dev" -t "$title" --angle 1 "${chapargs[@]}" \
        -e nvenc_h264 -q 20 -B 160 "${deintargs[@]}" \
        "${subargs[@]}" -o "$outpath" </dev/null; then
        echo "Error: HandBrake failed on Title $title ch $chap ($outfile)."
        fails=$((fails + 1))
    fi
    ep=$((ep + 1))
done <<< "$detected"

if [ "$fails" -ne 0 ]; then
    ding bell
    echo "Done, but $fails episode(s) failed. Re-run the same command to retry."
    exit 1
fi
ding
echo "Done! $total episodes saved to $season_dir/"
